# Copy to .env and fill in your own values (.env and .env.local are not committed). No real values here.
# The full list and what each one does — docs/spec 16 §4. Secrets are at least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Core (16 §4.1)
PUBLIC_URL=
SESSION_SECRET=
LINK_SECRET=
LOG_SALT=
# Vercel, Production only (the daily Cron sends it itself)
CRON_SECRET=
# NOTIFY_MODE=off      (nothing goes to Telegram; for the local run and the seed)
# Never set TZ: time goes through clock.now() and Asia/Tashkent in formatting.

# Staff sign-in (12 §2, D-16): accounts live in the base — create them with  npm run staff -- add --login aziz --name "Азиз" --role manager|head
# (the password is typed hidden). The session cookie is signed with SESSION_SECRET (≥ 32 characters, above).
# Optional token for scripts calling the manager API (Authorization: Bearer …) — at least 16 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# PORT=3000
# MCP server (POST /mcp; on its own: node server/mcp/index.js, port 3001; 08 §7). Two different tokens of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The client token works as the demo client MCP_CLIENT_ID (D-24; npm run mcp:client creates it), the head token as the head.
MCP_CLIENT_TOKEN=
MCP_HEAD_TOKEN=
MCP_CLIENT_ID=

# Telegram (10 §2.1, 16 §4). No token — the bot is off, the site works. Locally the test bot, on Vercel the main one.
# In the local .env the main bot lives under TELEGRAM_PROD_* (+ PROD_PUBLIC_URL), only for `npm run tg:setup -- --prod`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32+ characters A-Za-z0-9_-; Telegram sends it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Staff group id, a negative number (D2-17)
TELEGRAM_STAFF_CHAT_ID=

# Vercel sets these itself (Storage → Neon, Storage → Blob); `vercel env pull` writes them to .env.local.
# Without DATABASE_URL the base is PGlite in .pglite/ (created, migrated and seeded on the first request; delete the folder to
# start over); without Blob texture sets go to public/textures/lib/.
# DATABASE_URL=
# PGLITE_DIR=         (another folder for the local PGlite base)
# BLOB_READ_WRITE_TOKEN=   (older Blob stores; newer ones give BLOB_STORE_ID and sign in with VERCEL_OIDC_TOKEN)
# BLOB_STORE_ID=

# Only for `npm test`: a throwaway Neon branch for test/db.test.js and test/db-types.test.js (skipped when empty).
# TEST_DATABASE_URL=

# AI (06 §15). Keys are created by the author: Gemini in Google AI Studio (its own Google Cloud project for this site,
# billing OFF — otherwise the free tier does not apply), Claude in the Anthropic Console. No GEMINI_API_KEY → the
# chat answers by scripts (06 §16); no ANTHROPIC_API_KEY → the chains end on Gemini (the default mode, D-01).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_DAILY_BUDGET_USD=5      (paid Anthropic spending per Tashkent day, then Claude is off till midnight, 06 §14.4)
# AI_TIMEOUTS={"fast":{"firstByteMs":2500,"totalMs":6000}}   (debugging only, 06 §8.5)
# AI_LOG_PROMPTS=0           (1 = print full requests to the console; local only, ignored on Vercel)

# Stripe, test mode only (05 §6): sk_test_… and the webhook signing secret of /api/payments/stripe/webhook.
# No STRIPE_SECRET_KEY → the Stripe method is off; card and Click emulators always work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=uzs        (or usd with STRIPE_USD_RATE=<sum per dollar>)

# Upstash QStash (04 §5): deadlines on time on Vercel. Locally not needed — jobs run on every /api request and by npm run jobs:run.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=                (only for a non-default region)
