{
  "name": "furniture-super-planner-3d",
  "version": "0.1.0",
  "description": "Domus — apartments and furniture in 3D, by Askar",
  "main": "server.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "textures": "node scripts/fetch-textures.js",
    "og": "node scripts/og-images.js",
    "preload": "node scripts/preload.js",
    "db:migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "staff": "node --env-file-if-exists=.env scripts/staff.js",
    "jobs:run": "node scripts/jobs-run.js",
    "stripe:check": "node --env-file-if-exists=.env scripts/stripe-check.js",
    "tg:setup": "node --env-file-if-exists=.env scripts/tg-setup.js",
    "ai:smoke": "node --env-file-if-exists=.env scripts/ai-smoke.js",
    "kb:index": "node scripts/kb-index.js",
    "eval:kb": "node scripts/eval-kb.js",
    "eval:agents": "node scripts/eval-agents.js",
    "mcp:client": "node scripts/mcp-client.js",
    "test:neon": "node --env-file-if-exists=.env scripts/test-neon.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@google/genai": "2.28.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/qstash": "2.12.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "3.9.11",
    "express": "^4.21.2",
    "grammy": "1.46.0",
    "stripe": "23.0.0",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "zod": "$zod"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-pgvector": "0.0.10",
    "linkedom": "0.18.13"
  }
}
