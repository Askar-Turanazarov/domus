{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vendor-three.js",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "excludeFiles": "{public/vendor/**,public/js/**,public/css/**,public/textures/sets/**,public/textures/lib/**}",
      "includeFiles": "{public/*.html,catalog.json,templates.json,apartment-templates.json,apartments.json,buildings/**,public/textures/{library.json,README.md,floor/**,wall/**,wood/**,fabric/**},server/db/migrations/**,server/i18n/**,legal/**,kb/**,assets/fonts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/textures/2k/:id/:file",
      "destination": "https://mhkookdedvmpvwwrwdty.supabase.co/storage/v1/object/public/textures/2k/:id/:file"
    }
  ],
  "headers": [
    {
      "source": "/((?!mini$|admin$|admin\\.html$|admin/|dashboard$|dashboard/|bookings\\.html$|calls\\.html$|api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-0NpJibtJni/vs9bJacK4pk7ARr1j/VocnRgknH7kXyc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; form-action 'self' https://checkout.stripe.com; base-uri 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(admin|admin\\.html|admin/.*|dashboard|dashboard/.*|bookings\\.html|calls\\.html|api/.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-0NpJibtJni/vs9bJacK4pk7ARr1j/VocnRgknH7kXyc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com; base-uri 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/((?!mini$|b/|pay/).*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/vendor/three/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000"
        }
      ]
    },
    {
      "source": "/textures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
