{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vendor-three.js",
  "regions": ["fra1"],
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 3 * * *" }],
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "excludeFiles": "{public/vendor/**,public/js/**,public/css/**,public/textures/sets/**,public/textures/lib/**}",
      "includeFiles": "{public/*.html,catalog.json,templates.json,apartment-templates.json,apartments.json,buildings/**,public/textures/{library.json,README.md,floor/**,wall/**,wood/**,fabric/**},server/db/migrations/**,server/i18n/**,legal/**,kb/**,assets/fonts/**}"
    }
  },
  "headers": [
    { "source": "/((?!mini$).*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/vendor/three/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000" }] },
    { "source": "/textures/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
